# Optional server-only Clerk JWT public key from Clerk Dashboard > API keys > Show JWT public key.
# Without it, Clerk's JWKS is fetched during token verification. Never prefix with EXPO_PUBLIC_.
CLERK_JWT_KEY=

# Neon sets these when pulling environment variables. The pooled URL is used by the API;
# the direct URL is preferred by scripts/migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Public URL of the deployed Expo API server for standalone/mobile builds.
# Expo Go development can use the current Metro host automatically.
EXPO_PUBLIC_API_URL=
